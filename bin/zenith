#!/usr/bin/env bash
# ==============================================================================
# Zenith Shell CLI Dispatcher
# https://github.com/Mizukiranere/zenith-shell
# ==============================================================================

ZENITH_DIR="${ZENITH_DIR:-$HOME/.zenith}"
ZENITH_THEME_FILE="$ZENITH_DIR/current_theme"

THEMES=("cyberpunk" "tokyonight" "catppuccin" "nord" "matrix" "dracula" "minimal")

get_active_theme() {
  if [ -f "$ZENITH_THEME_FILE" ]; then
    cat "$ZENITH_THEME_FILE" 2>/dev/null | tr -d ' \n\r'
  else
    echo "cyberpunk"
  fi
}

cmd_list() {
  local current
  current=$(get_active_theme)
  printf "\n\033[1;36m🎨 Available Zenith Themes:\033[0m\n"
  for t in "${THEMES[@]}"; do
    if [ "$t" = "$current" ]; then
      printf "  \033[1;32m• %s (active)\033[0m\n" "$t"
    else
      printf "  \033[0;37m• %s\033[0m\n" "$t"
    fi
  done
  printf "\nUsage: zenith set <theme-name>\n\n"
}

cmd_set() {
  local target="$1"
  if [ -z "$target" ]; then
    printf "\033[1;31m❌ Error: Please specify a theme name. Example: zenith set tokyonight\033[0m\n"
    return 1
  fi

  local found=0
  for t in "${THEMES[@]}"; do
    if [ "$t" = "$target" ]; then
      found=1
      break
    fi
  done

  if [ $found -eq 1 ]; then
    mkdir -p "$ZENITH_DIR"
    echo "$target" > "$ZENITH_THEME_FILE"
    printf "\033[1;32m✨ Zenith theme switched to: %s\033[0m\n" "$target"
    printf "Restart your terminal or press Enter to see changes.\n"
  else
    printf "\033[1;31m❌ Unknown theme '%s'. Run 'zenith list' to see available themes.\033[0m\n" "$target"
    return 1
  fi
}

cmd_preview() {
  printf "\n\033[1;33m🌟 Zenith Themes Preview:\033[0m\n\n"
  for t in "${THEMES[@]}"; do
    ZENITH_THEME="$t"
    source "$ZENITH_DIR/core/zenith.sh" 2>/dev/null || true
    zenith_load_colors
    printf "\033[1m[%s]\033[0m\n" "$t"
    printf "  %b~/projects/app%b %b main%b\n" "$C_DIR" "$C_RESET" "$C_GIT" "$C_RESET"
    printf "  %b➜%b %b❯%b ls\n\n" "$C_SUCCESS" "$C_RESET" "$C_ARROW" "$C_RESET"
  done
}

cmd_info() {
  local current
  current=$(get_active_theme)
  printf "\n\033[1;36m⚡ Zenith Shell Prompt Engine\033[0m\n"
  printf "  Active Theme : \033[1;37m%s\033[0m\n" "$current"
  printf "  Installed At : \033[0;37m%s\033[0m\n" "$ZENITH_DIR"
  printf "  Shell Hook   : \033[0;37mBash / Zsh / Termux\033[0m\n\n"
}

case "$1" in
  list)
    cmd_list
    ;;
  set)
    cmd_set "$2"
    ;;
  preview)
    cmd_preview
    ;;
  info)
    cmd_info
    ;;
  help|--help|-h|*)
    printf "\n\033[1;36m⚡ Zenith Shell CLI\033[0m\n"
    printf "  zenith list            - List all available themes\n"
    printf "  zenith set <theme>     - Switch the active theme\n"
    printf "  zenith preview         - Preview all themes visually\n"
    printf "  zenith info            - Display active theme & paths\n\n"
    ;;
esac
